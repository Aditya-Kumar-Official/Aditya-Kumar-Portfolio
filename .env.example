# Copy to .env.local (never commit it) and fill in.
# Contact form: https://www.emailjs.com  (the public key is meant to be browser-visible;
# restrict allowed domains in the EmailJS dashboard to stop abuse)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Your live URL, used for canonical, Open Graph and sitemap.xml. On Vercel this is filled in
# automatically from the production domain, so you only need it for other hosts.
VITE_SITE_URL=
